{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/docs/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/docs/index.py"
    },
    {
      "source": "/api/public/(.*)",
      "destination": "/api/public_predict/index.py"
    },
    {
      "source": "/api/v1/risk/(.*)",
      "destination": "/api/risk/index.py"
    },
    {
      "source": "/api/v1/analyst/(.*)",
      "destination": "/api/analyst/index.py"
    },
    {
      "source": "/api/v1/policies/(.*)",
      "destination": "/api/policies/index.py"
    },
    {
      "source": "/api/v1/metrics/(.*)",
      "destination": "/api/metrics/index.py"
    },
    {
      "source": "/api/v1/audit/(.*)",
      "destination": "/api/audit/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/public/(.*)",
      "destination": "/api/public_predict.py"
    },
    {
      "source": "/api/v1/risk/(.*)",
      "destination": "/api/risk.py"
    },
    {
      "source": "/api/v1/analyst/(.*)",
      "destination": "/api/analyst.py"
    },
    {
      "source": "/api/v1/policies/(.*)",
      "destination": "/api/policies.py"
    },
    {
      "source": "/api/v1/metrics/(.*)",
      "destination": "/api/metrics.py"
    },
    {
      "source": "/api/v1/audit/(.*)",
      "destination": "/api/audit.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
